# Run without noise in a simulator SLOS - Strong Linear Optic Simulation
remote_processor = RemoteProcessor("sim:slos")  # RemoteProcessor is used to connect to the Quandela cloud
remote_processor.set_circuit(circuit)    # setting the circuit
remote_processor.min_detected_photons_filter(1)  # required when the noise is there
remote_processor.with_input(input_state)

remote_sampler = Sampler(remote_processor, max_shots_per_call = 1e6)
remote_sampler.default_job_name = "Hello World!"
remote_job = remote_sampler.sample_count.execute_async(n_samples)

# Output 
results = remote_job.get_results()
pcvl.pdisplay(results['results'])
